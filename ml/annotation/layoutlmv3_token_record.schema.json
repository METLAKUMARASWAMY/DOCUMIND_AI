{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documind.local/schemas/layoutlmv3-token-record.schema.json",
  "title": "DocuMind LayoutLMv3 token annotation record",
  "type": "object",
  "required": ["document_id", "page_id", "image_path", "width", "height", "words"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "page_id": {"type": "string", "minLength": 1},
    "image_path": {"type": "string", "minLength": 1},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "bounding_box", "label"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "bounding_box": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": 0},
              {"type": "number", "minimum": 0},
              {"type": "number", "minimum": 0},
              {"type": "number", "minimum": 0}
            ],
            "minItems": 4,
            "maxItems": 4
          },
          "label": {"type": "string", "minLength": 1},
          "line_id": {"type": ["string", "null"]},
          "block_id": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
